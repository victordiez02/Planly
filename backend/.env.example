# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Postgres ──────────────────────────────────────────────────────────────────
# Local: el docker-compose.yml expone Postgres en 5434.
# Producción: usa Supabase / Neon (postgresql+psycopg://user:pass@host:5432/db?sslmode=require)
DATABASE_URL=postgresql+psycopg://plans:plans@localhost:5434/plans

# ── JWT / Session ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-prod-please-very-long-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=43200

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Lista CSV. En prod: https://planly.web.app,https://planly.app
CORS_ORIGINS=http://localhost:5173

# ── Cookies (auth) ────────────────────────────────────────────────────────────
# Local (mismo origen vía proxy de Vite): false / lax
# Producción cross-origin (Firebase ↔ Cloud Run): true / none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.planly.app

# ── Email ─────────────────────────────────────────────────────────────────────
# smtp | resend | console
EMAIL_PROVIDER=smtp
EMAIL_FROM=Planly <planly@local.test>

# SMTP (Mailhog por defecto en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Resend (cuando EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Scheduler ─────────────────────────────────────────────────────────────────
# En local puedes activar el APScheduler interno; en Cloud Run debe ser false.
ENABLE_INTERNAL_SCHEDULER=true
TIMEZONE=Europe/Madrid

# ── Cron HTTP (para Cloud Scheduler) ─────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=

# ── Dev ───────────────────────────────────────────────────────────────────────
DEV_BYPASS_AUTH=true
