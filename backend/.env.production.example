# ─── PRODUCCIÓN (Cloud Run + Supabase + Resend + Firebase Hosting) ────────────
# Carga estas variables como variables de entorno del servicio Cloud Run
# (no subas este archivo con secretos reales: usa Secret Manager para los
# valores sensibles — DATABASE_URL, SECRET_KEY, GOOGLE_*, RESEND_API_KEY, CRON_SECRET).

ENVIRONMENT=production

# Supabase / Neon connection string. Importante: sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres:PASS@db.xxxx.supabase.co:5432/postgres?sslmode=require

SECRET_KEY=replace-with-64-bytes-random
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=43200

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REDIRECT_URI=https://api.planly.app/auth/google/callback

FRONTEND_URL=https://planly.web.app
CORS_ORIGINS=https://planly.web.app,https://planly.app

# Cross-origin: cookie debe ser Secure + SameSite=None.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.planly.app   # solo si front y api comparten dominio raíz

EMAIL_PROVIDER=resend
EMAIL_FROM=Planly <hola@planly.app>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# En Cloud Run NO uses el scheduler interno.
ENABLE_INTERNAL_SCHEDULER=false
TIMEZONE=Europe/Madrid

# Compartido con Cloud Scheduler (header X-Cron-Token).
CRON_SECRET=replace-with-random-token

DEV_BYPASS_AUTH=false
